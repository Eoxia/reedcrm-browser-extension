{
    "manifest_version": 3,
    "name": "ReedCRM",
    "version": "23.0.3",
    "default_locale": "fr",
    "description": "ReedCRM – Votre CRM directement dans votre navigateur. Gagnez du temps et optimisez votre suivi commercial depuis Chrome.",
    "icons": {
        "32": "icon32.png",
        "128": "icon128.png",
        "192": "icon192.png"
    },
    "action": {
        "default_popup": "ui/popup/popup.html",
        "default_icon": {
            "32": "icon32.png",
            "128": "icon128.png",
            "192": "icon192.png"
        }
    },
    "options_page": "ui/options/options.html",
    "background": {
        "service_worker": "src/background/background.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "src/content/content.js"
            ],
            "css": [
                "src/content/content.css"
            ]
        }
    ],
    "host_permissions": [],
    "permissions": [
        "storage",
        "activeTab",
        "scripting",
        "unlimitedStorage"
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "icon32.png",
                "icon128.png",
                "icon192.png"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}